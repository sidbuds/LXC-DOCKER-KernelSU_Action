# ==========================================
# 红米 Note 8 Pro (begonia) Docker 内核编译配置
# ==========================================

# 1. 内核源码与设备树 (专门适配 MT6785 G90T)
KERNEL_SOURCE=https://github.com/begonia-dev/android_kernel_xiaomi_mt6785
KERNEL_SOURCE_BRANCH=13.0
KERNEL_CONFIG=begonia_user_defconfig

# 2. 架构与镜像输出格式 (联发科平台必须为 Image.gz-dtb)
ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb

# 3. 核心：全套 LLVM / Clang 工具链参数 (消灭 gcc 汇编器不兼容问题)
EXTRA_CMDS:LD=ld.lld
EXTRA_CMDT:LLVM=1
EXTRA_CMDU:LLVM_IAS=1
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# 4. 编译器方案 (纯 Clang / LLVM 编译)
METHOD_OK=B
USE_CUSTOM_CLANG=false
CLANG_BRANCH=android-msm-coral-4.14-android13
CLANG_VERSION=r416183b

# 5. 关键：开启全套 LXC 与 DOCKER 容器特性
LXC_DOCKER=true
LXC_PATCH=false
ANDROID_PARANOID_NETWORK_OFF=true

# 6. 开启 KernelSU (系统底层 Root)
ENABLE_KERNELSU=true
KERNELSU_TAG=v0.9.5

# 7. 内核补丁扩展
DISABLE-LTO=true
DISABLE_CC_WERROR=true
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true

# 8. 编译加速与产物输出
ENABLE_CCACHE=true
NEED_DTBO=false
BUILD_BOOT_IMG=false
