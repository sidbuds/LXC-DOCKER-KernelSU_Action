# 内核源码地址 (小米官方开源 MIUI 12.5 Android 11 原厂源码仓库)
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
# 内核源码分支 (Redmi Note 8 Pro 官方 Android R / MIUI 12.5 分支)
KERNEL_SOURCE_BRANCH=begonia-r-oss
# 内核编译配置
KERNEL_CONFIG=begonia_user_defconfig
# 内核Image.gz-dtb or Image
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
# 附加编译参数
EXTRA_CMDS:LD=ld.lld
EXTRA_CMDT:LLVM=1
EXTRA_CMDU:LLVM_IAS=1

########################################################################################################################################################
# 编译方式选择 'A'clang+gcc编译 'B'clang编译
METHOD_OK=B

# 是否选择'true'使用自定义Clang  'false'使用官方AOSP
USE_CUSTOM_CLANG=true

# python切换默认python3(ture切换python2)
CUT_PYTHON=false

# 自定义Clang (原作者标准验证源 Clang 14 r445002)
## Custom
CUSTOM_CLANG_SOURCE=https://github.com/AOSP-12/prebuilts_clang_host_linux-x86_clang-r445002.git
CUSTOM_CLANG_BRANCH=12

### 当使用自定义clang为false时需要自定义CMDS 
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

## 官方AOSP
# 分支
CLANG_BRANCH=android-gs-bluejay-5.10-android13
# 版本
CLANG_VERSION=clang-r416183b

########################################################################################################################################################

# 开启 LXC and DOCKER
LXC_DOCKER=true

# 是否修复LXC依赖 (4.14内核无需打补丁)
LXC_PATCH=false

# 关闭CONFIG_ANDROID_PARANOID_NETWORK配置防止docker and lxc网络异常
ANDROID_PARANOID_NETWORK_OFF=true

#######################################################################################################################################################

# 开启 KernelSU flags
ENABLE_KERNELSU=true
KERNELSU_TAG=v0.9.5

# 杂项 Configuration
DISABLE-LTO=false
DISABLE_CC_WERROR=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true

########################################################################################################################################################
# 开启 KVM 虚拟化
ENABLE_KVM=false

########################################################################################################################################################

# 开启Ccache
ENABLE_CCACHE=true

# DTBO image
NEED_DTBO=false

# 编译内核直接制作Build boot images
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
